generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Lobby {
  id             Int      @id @default(autoincrement())
  mode           String
  region         String
  micRequired    Boolean  @default(true)
  maxPlayers     Int
  currentPlayers Int      @default(1)
  note           String
  createdAt      DateTime @default(now())
  expiresAt      DateTime
}
